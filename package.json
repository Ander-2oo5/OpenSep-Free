{
  "name": "opensep",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@11.25.0",
  "scripts": {
    "dev": "corepack pnpm -r --parallel --filter @opensep/api --filter @opensep/runner --filter @opensep/web dev",
    "build": "corepack pnpm -r build",
    "package:windows": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/build-windows-installer.ps1",
    "test": "corepack pnpm -r test",
    "typecheck": "corepack pnpm -r typecheck",
    "start": "corepack pnpm --filter @opensep/api start"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "typescript": "^5.9.0",
    "vitest": "^4.0.0"
  }
}
